# Optional — only needed if you later fetch files from Supabase server-side
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# CORS: comma-separated origins (default includes localhost:3000)
CORS_ORIGINS=http://localhost:3000

# Day 5 — Google Gemini BOQ structuring (required for "Structure with AI")
# Get a key: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key
# Optional alias (same key as above)
# GOOGLE_API_KEY=your-gemini-api-key
# Optional model override (default: gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash
# Set to false only on dev machines with SSL inspection (antivirus/corporate proxy)
GEMINI_SSL_VERIFY=true
